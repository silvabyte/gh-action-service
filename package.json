{
  "name": "gh-action-service",
  "version": "0.1.0",
  "description": "Clone-and-run supervisor for a pool of ephemeral (JIT) GitHub Actions org runners on the local machine",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "groups": "bun run src/groups.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-bun": "^0.91.0",
    "effect": "^3.22.0"
  }
}
