# --- Required ---

# Fine-grained PAT with the organization permission:
#   "Self-hosted runners" -> Read and write
# Resource owner must be your org. See README for step-by-step.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# The organization login the runners register against.
GITHUB_ORG=my-org

# --- Optional (defaults shown) ---

# How many ephemeral runners to keep alive at once.
RUNNER_COUNT=2

# Comma-separated custom labels. GitHub also auto-adds self-hosted, os, and arch.
RUNNER_LABELS=self-hosted

# Runner group id. The org default group is 1. Run `bun run groups` to list them.
RUNNER_GROUP_ID=1

# actions/runner release to use, or "latest" to resolve the newest automatically.
# "latest" is re-checked about every 15 minutes, and immediately if GitHub
# rejects the running version as deprecated. A failed lookup keeps the current one.
RUNNER_VERSION=latest

# Runner name prefix; the slot index is appended (e.g. my-laptop-0, my-laptop-1).
# Defaults to this machine's hostname.
# RUNNER_NAME_PREFIX=my-laptop

# Where the runner binary + per-runner working dirs live (gitignored).
RUNNERS_DIR=.runners
